rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid);
    }

    function isActiveMember(organizationId) {
      return signedIn()
        && exists(memberPath(organizationId))
        && get(memberPath(organizationId)).data.status == 'active';
    }

    function rolePath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/roles/$(get(memberPath(organizationId)).data.roleId);
    }

    function hasPermission(organizationId, permission) {
      return isActiveMember(organizationId)
        && exists(rolePath(organizationId))
        && get(rolePath(organizationId)).data.permissions.hasAny([permission]);
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /memberships/{organizationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /organizations/{organizationId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow read: if hasPermission(organizationId, 'organization.read');
      allow update: if hasPermission(organizationId, 'organization.manage');
      allow delete: if false;

      match /members/{memberId} {
        allow read: if hasPermission(organizationId, 'directory.read');
        allow create: if hasPermission(organizationId, 'directory.manage')
          && (
            request.resource.data.roleId in ['employee', 'manager']
            || hasPermission(organizationId, 'roles.manage')
          );
        allow update: if hasPermission(organizationId, 'directory.manage')
          && (
            request.resource.data.roleId == resource.data.roleId
            || hasPermission(organizationId, 'roles.manage')
          );
        allow delete: if hasPermission(organizationId, 'directory.manage')
          && memberId != request.auth.uid;
      }

      match /teams/{teamId} {
        allow read: if hasPermission(organizationId, 'directory.read');
        allow create, update, delete: if hasPermission(organizationId, 'directory.manage');
      }

      match /roles/{roleId} {
        allow read: if hasPermission(organizationId, 'roles.read');
        allow create: if hasPermission(organizationId, 'roles.manage')
          && request.resource.data.builtIn == false;
        allow update, delete: if hasPermission(organizationId, 'roles.manage')
          && resource.data.builtIn == false;
      }

      match /reviewTemplates/{templateId} {
        allow read: if hasPermission(organizationId, 'reviews.read')
          || hasPermission(organizationId, 'reviews.manage');
        allow create, update, delete: if hasPermission(organizationId, 'reviews.manage');
      }

      match /reviewCycles/{cycleId} {
        allow read: if hasPermission(organizationId, 'reviews.read')
          || hasPermission(organizationId, 'reviews.manage');
        allow create, update, delete: if hasPermission(organizationId, 'reviews.manage');

        match /reviews/{reviewId} {
          allow read: if hasPermission(organizationId, 'reviews.read_all')
            || (
              hasPermission(organizationId, 'reviews.read')
              && resource.data.reviewerId == request.auth.uid
            );
          allow create, delete: if hasPermission(organizationId, 'reviews.manage');
          allow update: if hasPermission(organizationId, 'reviews.manage')
            || (
              hasPermission(organizationId, 'reviews.submit')
              && resource.data.reviewerId == request.auth.uid
              && get(/databases/$(database)/documents/organizations/$(organizationId)/reviewCycles/$(cycleId)).data.state == 'review_writing'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'answers', 'state', 'updatedAt', 'submittedAt'
              ])
              && request.resource.data.state in ['draft', 'submitted']
              && (resource.data.state != 'submitted' || request.resource.data.state == 'submitted')
            );
        }

        // Program records below are written only by the server (Admin SDK) after
        // relationship-aware authorization. Clients get narrow, read-only access.
        match /nominations/{nominationId} {
          allow read: if hasPermission(organizationId, 'reviews.manage')
            || (
              isActiveMember(organizationId)
              && (resource.data.subjectId == request.auth.uid || resource.data.peerId == request.auth.uid)
            );
          allow write: if false;
        }

        match /calibrations/{subjectId} {
          allow read: if hasPermission(organizationId, 'reviews.calibrate');
          allow write: if false;
        }

        match /packets/{subjectId} {
          allow read: if hasPermission(organizationId, 'reviews.calibrate')
            || (
              isActiveMember(organizationId)
              && subjectId == request.auth.uid
              && resource.data.state != 'withdrawn'
            );
          allow write: if false;
        }
      }

      match /goals/{goalId} {
        allow read: if isActiveMember(organizationId)
          && (
            resource.data.visibility == 'public'
            || resource.data.ownerId == request.auth.uid
            || hasPermission(organizationId, 'reviews.read_all')
          );
        allow write: if false;
      }

      match /feedback/{feedbackId} {
        allow read: if isActiveMember(organizationId)
          && (
            resource.data.authorId == request.auth.uid
            || resource.data.recipientId == request.auth.uid
          );
        allow write: if false;
      }

      match /oneOnOnes/{meetingId} {
        allow read: if isActiveMember(organizationId)
          && request.auth.uid in resource.data.participantIds;
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isActiveMember(organizationId)
          && resource.data.recipientId == request.auth.uid;
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if hasPermission(organizationId, 'audit.read');
        allow create: if hasPermission(organizationId, 'audit.write')
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Fleet products (research, planner, creator, ...) are server-only: every read and
    // write goes through Next.js routes that verify the product session and tenant
    // membership with the Admin SDK. Browser SDK access is denied outright.
    match /products/{product}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
