# Public site URL. Keep localhost until the custom domain resolves over HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable canonical subdomain links and legacy-route redirects only after every
# capability DNS record resolves to Vercel.
FLEET_SUBDOMAINS_ENABLED=false

# Firebase Web SDK configuration. These identifiers are intentionally public;
# tenant data remains protected by Firebase Auth, server authorization, and rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saasassin-net.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saasassin-net
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=saasassin-net.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=683459494392
NEXT_PUBLIC_FIREBASE_APP_ID=1:683459494392:web:40968212c46dccbb87160d

# Server-only Firebase Admin credentials. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=

# Preferred locally: an absolute path to a least-privilege service-account key
# stored outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Alternative for deployments that inject individual secret values.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional Firebase Storage bucket for later evidence uploads.
FIREBASE_STORAGE_BUCKET=

# Privacy-conscious, cookieless product analytics. The project token is public
# by design, but keep each product in its own PostHog project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only access key for the unlisted operations dashboard.
OPS_ACCESS_KEY=
